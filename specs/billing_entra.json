{
  "specVersion": "2.0.0",
  "category": "Azure Billing and Microsoft Entra ID Tenants",
  "profile": "baseline",
  "defaults": {
    "scope": "tenant",
    "severity": "High",
    "coverage": "Auto",
    "attestation": {
      "enabled": true,
      "expiresDays": 180
    }
  },
  "checks": [
    {
      "id": "ENTRA-DOMAINS-VERIFIED",
      "title": "All tenant domains must be verified",
      "severity": "High",
      "executor": "graph",
      "sources": ["Graph.v1.Domains"],
      "logic": {
        "allOf": [
          { "gte": { "path": "$.domains.length()", "value": 1 } },
          { "equals": { "path": "$.domains[?(@.isVerified==false)].length()", "value": 0 } }
        ]
      },
      "evidence": {
        "summaryTemplate": "Tenant domain verification check.",
        "linkTemplates": [
          "https://portal.azure.com/#view/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/~/CustomDomainNames"
        ]
      },
      "remediationHint": "Verify all unverified domains in the Azure AD portal."
    },
    {
      "id": "ENTRA-SECURITY-DEFAULTS-OR-CA",
      "title": "Security Defaults enabled OR Conditional Access baseline configured",
      "severity": "High",
      "executor": "graph",
      "sources": ["Graph.v1.Policies", "Graph.beta.ConditionalAccess"],
      "logic": {
        "anyOf": [
          { "equals": { "path": "$.policies.securityDefaults.state", "value": "enabled" } },
          {
            "allOf": [
              { "exists": { "path": "$.caPolicies[?(@.state=='enabled')]" } },
              { "contains": { "path": "$.caPolicies[*].grantControls.builtInControls", "value": "mfa" } },
              { "contains": { "path": "$.caPolicies[*].conditions.users.includeUsers", "value": "All" } }
            ]
          }
        ]
      },
      "evidence": {
        "summaryTemplate": "Security Defaults or CA baseline verification.",
        "linkTemplates": [
          "https://entra.microsoft.com/#view/Microsoft_AAD_ConditionalAccess/PoliciesMenuBlade/~/Policies",
          "https://entra.microsoft.com/#view/Microsoft_AAD_IAM/SecurityMenuBlade/~/SecurityDefaults"
        ]
      },
      "remediationHint": "Enable Security Defaults or configure Conditional Access policies with MFA for all users."
    },
    {
      "id": "ENTRA-MFA-REQUIRED-ALL-USERS",
      "title": "MFA required for all users with controlled exceptions",
      "severity": "High",
      "executor": "graph",
      "sources": ["Graph.beta.ConditionalAccess"],
      "logic": {
        "allOf": [
          { "exists": { "path": "$.caPolicies[?(@.state=='enabled')]" } },
          { "contains": { "path": "$.caPolicies[*].grantControls.builtInControls", "value": "mfa" } },
          { "contains": { "path": "$.caPolicies[*].conditions.users.includeUsers", "value": "All" } },
          { "lte": { "path": "$.caPolicies[*].conditions.users.excludeUsers.length()", "value": 2 } }
        ]
      },
      "evidence": {
        "summaryTemplate": "Global MFA verification with exception control.",
        "linkTemplates": [
          "https://entra.microsoft.com/#view/Microsoft_AAD_ConditionalAccess/PoliciesMenuBlade/~/Policies"
        ]
      },
      "remediationHint": "Configure CA policy requiring MFA for 'All Users' with maximum 2 exclusions."
    },
    {
      "id": "ENTRA-PIM-CRITICAL-ROLES",
      "title": "PIM configured for critical administrative roles",
      "severity": "High",
      "executor": "graph",
      "sources": ["Graph.beta.PrivilegedAccess"],
      "logic": {
        "allOf": [
          { "exists": { "path": "$.privilegedRoles[?(@.displayName=='Global Administrator')]" } },
          { "exists": { "path": "$.privilegedRoles[?(@.displayName=='Security Administrator')]" } },
          { "gte": { "path": "$.privilegedRoles[?(@.isActivationRequired==true)].length()", "value": 2 } }
        ]
      },
      "evidence": {
        "summaryTemplate": "PIM verification for critical roles.",
        "linkTemplates": [
          "https://entra.microsoft.com/#view/Microsoft_Azure_PIMCommon/CommonMenuBlade/~/aadmigratedroles"
        ]
      },
      "fallback": {
        "manualRequired": true,
        "reason": "PIM API requires specific permissions and configuration"
      },
      "remediationHint": "Configure PIM for Global Administrator and Security Administrator with mandatory activation."
    },
    {
      "id": "ENTRA-SSPR-ENABLED",
      "title": "Self-Service Password Reset enabled for all users",
      "severity": "Medium",
      "executor": "graph",
      "sources": ["Graph.beta.Policies"],
      "logic": {
        "equals": { "path": "$.passwordResetPolicies.enablementType", "value": "all" }
      },
      "evidence": {
        "summaryTemplate": "SSPR verification for users.",
        "linkTemplates": [
          "https://entra.microsoft.com/#view/Microsoft_AAD_IAM/PasswordResetMenuBlade/~/Properties"
        ]
      },
      "fallback": {
        "manualRequired": true,
        "reason": "SSPR policy endpoint requires specific API version"
      },
      "remediationHint": "Enable SSPR for all users in the Azure AD portal."
    },
    {
      "id": "BILLING-BUDGETS-PER-SUBSCRIPTION",
      "title": "Budget configured for each subscription",
      "severity": "High",
      "executor": "cost",
      "sources": ["Cost.Budgets"],
      "logic": {
        "allOf": [
          { "gte": { "path": "$.budgets.length()", "value": 1 } },
          { "equals": { "path": "$.budgets[?(@.amount==null)].length()", "value": 0 } }
        ]
      },
      "evidence": {
        "summaryTemplate": "Budget verification per subscription.",
        "linkTemplates": [
          "https://portal.azure.com/#view/Microsoft_Azure_CostManagement/Menu/~/budgets"
        ]
      },
      "fallback": {
        "manualRequired": true,
        "reason": "Cost Management API integration not fully implemented"
      },
      "remediationHint": "Configure budgets with alerts for each active subscription."
    },
    {
      "id": "BILLING-COST-EXPORTS",
      "title": "Cost export configured for external analysis",
      "severity": "Medium",
      "executor": "cost",
      "sources": ["Cost.Exports"],
      "logic": {
        "gte": { "path": "$.exports.length()", "value": 1 }
      },
      "evidence": {
        "summaryTemplate": "Cost export configuration verification.",
        "linkTemplates": [
          "https://portal.azure.com/#view/Microsoft_Azure_CostManagement/Menu/~/exports"
        ]
      },
      "fallback": {
        "manualRequired": true,
        "reason": "Cost Management API integration not fully implemented"
      },
      "remediationHint": "Configure automatic cost data export to storage account."
    },
    {
      "id": "BILLING-RBAC-SEPARATION",
      "title": "RBAC separation for billing functions",
      "severity": "Medium",
      "executor": "arm",
      "sources": ["ARM.RoleAssignments"],
      "logic": {
        "allOf": [
          { "exists": { "path": "$.roleAssignments[?(@.roleDefinitionId contains 'Billing Reader')]" } },
          { "lte": { "path": "$.roleAssignments[?(@.roleDefinitionId contains 'Owner')].length()", "value": 3 } }
        ]
      },
      "evidence": {
        "summaryTemplate": "Billing role separation verification.",
        "linkTemplates": [
          "https://portal.azure.com/#view/Microsoft_Azure_SubscriptionManagement/SubscriptionResourceMenuBlade/~/AccessControl"
        ]
      },
      "fallback": {
        "manualRequired": true,
        "reason": "Billing role assignments require specific scope analysis"
      },
      "remediationHint": "Configure specific billing roles (Billing Reader) separated from administrative roles."
    },
    {
      "id": "ENTRA-LOGS-TO-LOG-ANALYTICS",
      "title": "Entra ID logs sent to Log Analytics",
      "severity": "High",
      "executor": "arm",
      "sources": ["ARM.DiagnosticSettings"],
      "logic": {
        "allOf": [
          { "exists": { "path": "$.diagnosticSettings[?(@.resourceType=='Microsoft.AAD/domainServices')]" } },
          { "exists": { "path": "$.diagnosticSettings[*].logs[?(@.enabled==true)]" } }
        ]
      },
      "evidence": {
        "summaryTemplate": "Entra ID diagnostic settings verification.",
        "linkTemplates": [
          "https://portal.azure.com/#view/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/~/DiagnosticSettings"
        ]
      },
      "fallback": {
        "manualRequired": true,
        "reason": "Entra ID diagnostic settings require tenant-level configuration"
      },
      "remediationHint": "Configure diagnostic settings to send Entra ID sign-in and audit logs to Log Analytics."
    }
  ]
}